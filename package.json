{
  "name": "nexus-pjm-project-hub",
  "version": "1.0.0",
  "description": "Nexus project hub hello world",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build-shared": "cd web/shared && npm run build",
    "build-web": "npm run build-shared && cd web/admin && npm run build && cd ../tiles && npm run build && cd ../admin-console && npm run build && cd ../admin-snippets && npm run build && cd ../admin-automations && npm run build && cd ../admin-tiles && npm run build",
    "build": "tsc && npm run build-web",
    "test": "tsx scripts/bootstrap.ts",
    "serve-admin-console": "cd web/admin-console && npm run start",
    "serve-admin-snippets": "cd web/admin-snippets && npm run start",
    "serve-admin-automations": "cd web/admin-automations && npm run start",
    "serve-admin-tiles": "cd web/admin-tiles && npm run start",
    "serve-admin": "cd web/admin && npm run start",
    "serve-tiles": "cd web/tiles && npm run start"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@pc-nexus/core": "^0.8.0-next.4",
    "@pc-nexus/network": "^0.8.0-next.4",
    "@pc-nexus/storage": "^0.8.0-next.4",
    "@pc-nexus/event": "^0.8.0-next.4",
    "quickjs-emscripten": "^0.32.0"
  }
}